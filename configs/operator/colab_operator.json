        "--execute-benchmark",
        "--allow-benchmark",
        "--i-acknowledge-gpu-cost"
      ]
    },
    "architecture_report": {
      "select": "12",
      "label": "Production identity benchmark status / report",
      "script": "core/scripts/report_identity_architecture_benchmark.py"
