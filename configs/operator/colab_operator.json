{
  "package": "colab_operator",
  "version": "1.0.0",
  "notes": [
    "Orchestration metadata for Cursor Agent browser workflows only.",
    "Does not change Package 4.12.3 benchmark semantics.",
    "Does not start Package 4.13.",
    "Canonical notebook is GitHub-backed — never a stale Drive copy."
  ],
  "canonical_notebook": {
    "repo": "morecolorfulthanHD/ai-studio-colab",
    "branch": "main",
    "path": "colab/notebooks/AI_Studio_Control_Panel_Colab.ipynb",
    "colab_url": "https://colab.research.google.com/github/morecolorfulthanHD/ai-studio-colab/blob/main/colab/notebooks/AI_Studio_Control_Panel_Colab.ipynb",
    "identity_markers": [
      "AI Studio Control Panel",
      "Repository Sync",
      "control_panel()"
    ],
    "reject_if_opened_from": [
      "Drive copy of notebook as source of truth",
      "duplicate launcher notebooks"
    ]
  },
  "runtime_expectations": {
    "repo_clone_path": "/content/ai-studio-colab",
    "drive_root": "/content/drive/MyDrive/AI_Studio",
    "comfyui_path": "/content/ComfyUI",
    "preferred_accelerator": "GPU",
    "expected_branch": "main"
  },
  "ui_labels": {
    "connect": ["Connect", "Reconnect", "Connect to a runtime"],
    "connected": ["Connected", "RAM", "Disk"],
    "runtime_type": ["Change runtime type", "GPU", "T4", "L4", "A100"],
    "run_all": ["Runtime", "Run all"],
    "disconnect_indicators": ["Connect", "Disconnected", "No connected runtime"]
  },
  "control_panel_menu": {
    "launch": {"select": "1", "label": "Launch (Safe / Minimal / Full)"},
    "launch_modes": {
      "safe": "safe",
      "minimal": "minimal",
      "full": "full"
    },
    "characters": {"select": "13", "label": "Characters (identity foundation / identity benchmark)"},
    "exit": {"select": "0", "label": "Exit"}
  },
  "characters_menu": {
    "list": {"select": "1", "label": "List characters"},
    "prepare_instantid": {
      "select": "11",
      "label": "Prepare production identity benchmark (InstantID SDXL)",
      "script": "core/scripts/prepare_identity_architecture_benchmark.py"
    },
    "run_instantid": {
      "select": "12",
      "label": "Run production identity benchmark (EXECUTE + automated QA)",
      "script": "core/scripts/run_identity_architecture_benchmark.py",
      "requires_ack_flags": [
        "--execute-benchmark",
        "--allow-benchmark",
        "--i-acknowledge-gpu-cost"
      ],
      "do_not_auto_start_without_explicit_user_request": true
    },
    "architecture_report": {
      "select": "13",
      "label": "Production identity QA / architecture report",
      "script": "core/scripts/report_identity_architecture_benchmark.py"
    },
    "faceid_prepare": {
      "select": "5",
      "label": "Prepare identity benchmark (benchmark ack required)",
      "status": "REJECTED_FOR_PRODUCTION_IDENTITY — do not re-run for production validation"
    },
    "back": {"select": "0", "label": "Back"}
  },
  "package_qa": {
    "consolidated_4123": {
      "script": "core/scripts/qa_package4123.py",
      "label": "Package 4.12.3 consolidated automated QA"
    },
    "operator_simulation": {
      "script": "core/scripts/simulate_colab_operator.py",
      "label": "Colab operator state-machine simulation"
    }
  },
  "states": [
    "NOT_OPEN",
    "COLAB_OPEN",
    "AUTH_REQUIRED",
    "DISCONNECTED",
    "CONNECTED",
    "REPO_SYNCED",
    "AI_STUDIO_READY",
    "FULL_LAUNCH_RUNNING",
    "FULL_LAUNCH_READY",
    "LIVE_QA_RUNNING",
    "HUMAN_REVIEW_REQUIRED",
    "FAILED",
    "COMPLETE"
  ],
  "stop_conditions": [
    "Google login",
    "ambiguous account chooser",
    "2FA / passkey",
    "Drive mount consent",
    "Colab paid GPU / billing consent",
    "CAPTCHA",
    "browser security confirmation",
    "HUMAN_REVIEW_REQUIRED from automated QA",
    "FULL_LAUNCH hard failure",
    "uncertain destructive action"
  ],
  "auto_allowed": [
    "reconnect disconnected runtime",
    "rerun startup / Repository Sync cells",
    "Run all when notebook identity is verified",
    "Full Launch (full) after recoverable reconnect when documented",
    "navigate control panel menus",
    "collect visible logs and QA report paths"
  ],
  "never_auto": [
    "Full Reset",
    "Drive deletion",
    "model deletion",
    "project deletion",
    "history deletion",
    "benchmark evidence deletion",
    "bypass license / asset verification gates",
    "FaceID / ReActor production re-runs",
    "start Package 4.13"
  ],
  "restart_policy": {
    "may_reconnect": true,
    "may_rerun_startup_cells": true,
    "may_rerun_full_launch_after_recoverable_restart": true,
    "may_change_gpu_runtime_without_asking": false,
    "require_user_when_uncertain": true
  }
}
