  "characters_menu": {
    "list": {"select": "1", "label": "List characters"},
    "run_production_identity_benchmark": {
      "select": "11",
      "label": "Run production identity benchmark",
      "script": "core/scripts/run_production_identity_benchmark.py",
      "orchestrates": [
        "character resolve",
        "preflight / InstantID readiness",
        "prepare S1-S4",
        "execute /prompt",
        "durable Drive capture",
        "automated QA",
        "architecture/status report"
      ],
      "routine_confirmation_prompt": "Run the full S1-S4 production identity benchmark now? This will use the active GPU runtime. [y/N]",
      "operator_may_satisfy_confirmation_when": "originating user request explicitly asked Cursor to RUN the live production identity benchmark",
      "do_not_auto_start_without_explicit_user_request": true,
      "lower_level_ack_flags_still_required_internally": [
        "--execute-benchmark",
        "--allow-benchmark",
        "--i-acknowledge-gpu-cost"
      ]
    },
    "status_report": {
      "select": "12",
      "label": "Production identity benchmark status / report",
      "script": "core/scripts/report_identity_architecture_benchmark.py"
    },
    "advanced": {
      "select": "13",
      "label": "Advanced identity benchmark tools",
      "expected_next_title": "=== Advanced identity benchmark tools ==="
    },
    "run_instantid": {
      "select": "11",
      "label": "Run production identity benchmark",
      "alias_of": "run_production_identity_benchmark",
      "notes": "Alias kept for older operator references; prefer run_production_identity_benchmark."
    },
    "prepare_instantid": {
      "select": "1",
      "menu": "advanced_identity",
      "label": "Prepare InstantID benchmark (debug)",
      "script": "core/scripts/prepare_identity_architecture_benchmark.py",
      "notes": "Advanced/debug only — not the normal user path."
    },
    "raw_execute": {
      "select": "2",
      "menu": "advanced_identity",
      "label": "Raw execute InstantID runner (legacy flags)",
